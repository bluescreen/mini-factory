# Die Fabrik über OpenRouter — drei Zeilen, kein Code.
#
#   cp env.openrouter.example .env.openrouter   # .env* ist ignoriert
#   $EDITOR .env.openrouter                     # Key eintragen
#   set -a; . ./.env.openrouter; set +a
#   node factory.js "Implement a FizzBuzz function"
#
# OpenRouter spricht das Anthropic-Messages-Format selbst, deshalb steht hier
# nur eine andere Adresse und nichts dazwischen. util.js bleibt unangetastet.
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-hier-dein-key

# Ausdrücklich leer, und ausdrücklich hier: der CLI zieht ANTHROPIC_API_KEY dem
# Token vor. Ein persönlicher Key, der in der Shell noch steht, würde sonst
# gewinnen — der Lauf liefe grün und die Rechnung ginge an das falsche Konto.
ANTHROPIC_API_KEY=

# Das Roster: welches Modell auf welchem Sitz. Ohne diese drei Zeilen laufen die
# Vorgaben aus factory.js weiter, also die Anthropic-Stufen ohne Gateway-Slug.
# box.js reicht die Namen mit den Credentials in die Box durch.
# Dieselbe Zuordnung wie das Roster `mixed` in Workshop 15: der Planner denkt
# lang und schreibt wenig, der Builder schreibt viel und wird vom Gate gefangen,
# der Reviewer liest einen Diff hinter einem grünen Gate. Der Katalog steht auf
# openrouter.ai/models, GLM und Kimi inklusive. Der Slug muss ein Modell
# benennen, das es gibt: `z-ai/glm-5.2` gibt es nicht, und der CLI nennt das
# dann `unrecognized_model` — auch dann, wenn in Wahrheit das Guthaben klemmt.
PLANNER_MODEL=google/gemini-3.6-flash
BUILDER_MODEL=deepseek/deepseek-v4-flash-0731
REVIEWER_MODEL=z-ai/glm-5.3-flash

# Dieselben Modelle wie bisher, nur über das Gateway:
# PLANNER_MODEL=anthropic/claude-sonnet-4.5
# BUILDER_MODEL=anthropic/claude-haiku-4.5
# REVIEWER_MODEL=anthropic/claude-sonnet-4.5
